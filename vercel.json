{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --omit=dev",
  "buildCommand": "echo 'Static site + optional API'",
  "outputDirectory": "website_v2",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "econ30finalproject.vercel.app" }],
      "destination": "https://sunmithallur.com/econ30/",
      "permanent": true
    },
    {
      "source": "/:path((?!__origin).*)",
      "has": [{ "type": "host", "value": "econ30finalproject.vercel.app" }],
      "destination": "https://sunmithallur.com/econ30/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/__origin", "destination": "/index.html" },
    { "source": "/__origin/", "destination": "/index.html" },
    { "source": "/__origin/:path*", "destination": "/:path*" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/scrolly-results.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/two-lives.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/essay-guide.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
